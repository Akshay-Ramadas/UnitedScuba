{
  "name": "united-scuba",
  "version": "1.0.0",
  "private": true,
  "main": "server/index.js",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n server,client -c cyan,green \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "node --watch server/index.js",
    "dev:client": "vite --config client/vite.config.js",
    "build": "vite build --config client/vite.config.js",
    "start": "node server/index.js",
    "seed": "node server/seed.js"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "cloudinary": "^2.5.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "lucide-react": "^1.47.0",
    "mongoose": "^8.9.5",
    "node-mailjet": "^6.0.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.2",
    "sanitize-html": "2.13.1",
    "tailwind-merge": "^3.7.0",
    "vite": "^5.4.14",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "autoprefixer": "^10.6.1",
    "concurrently": "^9.1.2",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3"
  }
}
